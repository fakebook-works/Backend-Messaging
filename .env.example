ConnectionStrings__PostgreSQL=Host=postgres;Port=5432;Database=fakebook;Username=fakebook;Password=replace-me;Search Path=messenger
# Optional: use a DDL-capable role here and keep the PostgreSQL runtime role least-privileged.
# ConnectionStrings__PostgreSQLMigration=Host=postgres;Port=5432;Database=fakebook;Username=fakebook_migrator;Password=replace-me;Search Path=messenger
DatabaseMigrations__Enabled=true
DatabaseMigrations__CommandTimeoutSeconds=300
Gateway__InternalSharedSecret=replace-with-at-least-32-bytes
InternalServices__MessengerSharedSecret=replace-with-a-different-secret-at-least-32-bytes
InternalServices__SocialGraph__BaseUrl=http://socialgraph
InternalServices__SocialGraph__SharedSecret=replace-with-socialgraph-secret-at-least-32-bytes
InternalServices__Upload__BaseUrl=http://upload
InternalServices__Upload__SharedSecret=replace-with-upload-secret-at-least-32-bytes
Messaging__AllowedAttachmentHosts__0=cdn.fakebook.example
